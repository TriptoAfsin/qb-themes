/* qb-themes · {{THEME_NAME}} · target: qBittorrent 5.x (Qt 6, Fusion style)
 * Generated by build.py from src/stylesheet.template.qss + themes/{{THEME_ID}}.json.
 * Edit those, not this file.
 */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    outline: none;
}

QWidget {
    background-color: {{bg-0}};
    color: {{text}};
    selection-background-color: {{accent-tint}};
    selection-color: {{text}};
}

QWidget:disabled { color: {{text-subtle}}; }

QMainWindow::separator { background: {{bg-0}}; width: 6px; height: 6px; }

/* ---------- Menu bar & menus ---------- */

QMenuBar {
    background: {{bg-0}};
    padding: 4px 6px 0 6px;
    border: none;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 11px;
    border-radius: 6px;
    color: {{text-muted}};
}
QMenuBar::item:selected { background: {{bg-2}}; color: {{text}}; }
QMenuBar::item:pressed  { background: {{bg-3}}; color: {{text}}; }

QMenu {
    background: {{bg-2}};
    border: 1px solid {{line-strong}};
    padding: 6px;
    border-radius: 8px;
}
QMenu::item {
    background: transparent;
    padding: 6px 26px 6px 10px;
    border-radius: 5px;
    color: {{text}};
}
QMenu::item:selected { background: {{bg-3}}; }
QMenu::item:disabled { color: {{text-subtle}}; }
QMenu::icon { padding-left: 8px; }
QMenu::separator { height: 1px; background: {{line-strong}}; margin: 5px 6px; }
QMenu::indicator { width: 14px; height: 14px; margin-left: 6px; }
QMenu::indicator:non-exclusive:checked { image: url({{DIR}}/ui/check.svg); }
QMenu::indicator:exclusive:checked     { image: url({{DIR}}/ui/dot.svg); }
QMenu::right-arrow { image: url({{DIR}}/ui/chevron-right.svg); width: 12px; height: 12px; }

/* ---------- Toolbar ---------- */

QToolBar {
    background: {{bg-0}};
    border: none;
    padding: 6px 8px;
    spacing: 4px;
}
QToolBar::separator { background: {{line}}; width: 1px; margin: 6px 6px; }

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px;
    color: {{text-muted}};
}
QToolButton:hover   { background: {{bg-2}}; border-color: {{line}}; color: {{text}}; }
QToolButton:pressed { background: {{bg-3}}; }
QToolButton:checked { background: {{accent-tint}}; border-color: {{accent-dim}}; color: {{text}}; }
QToolButton:disabled { color: {{text-subtle}}; }
QToolButton::menu-indicator { image: none; width: 0; }
QToolButton::menu-button { border: none; width: 14px; }
QToolButton::menu-arrow { image: url({{DIR}}/ui/chevron-down.svg); width: 10px; height: 10px; }

/* ---------- Inputs ---------- */

QLineEdit, QAbstractSpinBox, QComboBox, QPlainTextEdit, QTextEdit, QDateTimeEdit {
    background: {{bg-2}};
    border: 1px solid {{line}};
    border-radius: 7px;
    padding: 5px 9px;
    color: {{text}};
    selection-background-color: {{accent-fill}};
    selection-color: {{accent-ink}};
}
QPlainTextEdit, QTextEdit { padding: 6px; }
QLineEdit:hover, QAbstractSpinBox:hover, QComboBox:hover { border-color: {{line-strong}}; }
QLineEdit:focus, QAbstractSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus { border-color: {{accent}}; }
QLineEdit:disabled, QAbstractSpinBox:disabled, QComboBox:disabled {
    background: {{bg-1}}; color: {{text-subtle}}; border-color: {{line}};
}
QLineEdit:read-only { background: {{bg-1}}; }

QComboBox { padding-right: 26px; min-height: 18px; }
QComboBox::drop-down { border: none; width: 24px; subcontrol-position: center right; }
QComboBox::down-arrow { image: url({{DIR}}/ui/chevron-down.svg); width: 12px; height: 12px; }
QComboBox::down-arrow:disabled { image: url({{DIR}}/ui/chevron-down-dim.svg); }
QComboBox QAbstractItemView {
    background: {{bg-2}};
    border: 1px solid {{line-strong}};
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: {{bg-3}};
    selection-color: {{text}};
}

QAbstractSpinBox { padding-right: 22px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    background: transparent; border: none; width: 20px;
}
QAbstractSpinBox::up-button   { subcontrol-position: top right; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: {{bg-3}}; }
QAbstractSpinBox::up-arrow   { image: url({{DIR}}/ui/chevron-up.svg);   width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url({{DIR}}/ui/chevron-down.svg); width: 10px; height: 10px; }

/* ---------- Buttons ---------- */

QPushButton {
    background: {{bg-2}};
    border: 1px solid {{line}};
    border-radius: 7px;
    padding: 6px 14px;
    color: {{text}};
    min-height: 16px;
}
QPushButton:hover   { background: {{bg-3}}; border-color: {{line-strong}}; }
QPushButton:pressed { background: {{bg-1}}; }
QPushButton:focus   { border-color: {{accent-dim}}; }
QPushButton:disabled { background: {{bg-1}}; color: {{text-subtle}}; border-color: {{line}}; }
QPushButton:default { background: {{accent}}; color: {{accent-ink}}; border-color: {{accent}}; font-weight: 600; }
QPushButton:default:hover   { background: {{accent-dim}}; border-color: {{accent-dim}}; }
QPushButton:default:disabled { background: {{bg-2}}; color: {{text-subtle}}; border-color: {{line}}; }

/* Checkable pushbuttons: the properties tab strip (General · Trackers · Peers …) */
QPushButton:checkable {
    background: transparent;
    border: 1px solid transparent;
    color: {{text-muted}};
    padding: 6px 12px;
}
QPushButton:checkable:hover   { background: {{bg-2}}; color: {{text}}; }
QPushButton:checkable:checked { background: {{bg-2}}; border-color: {{line-strong}}; color: {{text}}; }

/* ---------- Check boxes & radios ---------- */

QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator,
QTreeView::indicator, QListView::indicator, QTableView::indicator, QGroupBox::indicator {
    width: 15px; height: 15px;
    border: 1px solid {{line-strong}};
    background: {{bg-2}};
}
QCheckBox::indicator, QTreeView::indicator, QListView::indicator,
QTableView::indicator, QGroupBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover,
QTreeView::indicator:hover, QGroupBox::indicator:hover { border-color: {{accent-dim}}; }
QCheckBox::indicator:checked, QTreeView::indicator:checked, QListView::indicator:checked,
QTableView::indicator:checked, QGroupBox::indicator:checked {
    background: {{accent}}; border-color: {{accent}}; image: url({{DIR}}/ui/check-ink.svg);
}
QCheckBox::indicator:indeterminate, QTreeView::indicator:indeterminate {
    background: {{accent-tint}}; border-color: {{accent}}; image: url({{DIR}}/ui/dash.svg);
}
QRadioButton::indicator:checked { background: {{bg-2}}; border-color: {{accent}}; image: url({{DIR}}/ui/dot.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: {{bg-1}}; border-color: {{line}}; }

/* ---------- Item views (transfer list, filters, files, peers) ---------- */

QAbstractItemView {
    background: {{bg-1}};
    alternate-background-color: {{bg-1-alt}};
    border: 1px solid {{line}};
    border-radius: 8px;
    selection-background-color: {{accent-tint}};
    selection-color: {{text}};
    show-decoration-selected: 1;
}
QAbstractItemView:focus { border-color: {{line-strong}}; }

/* No `color:` on ::item, so qBittorrent's per-state row colours stay intact. */
QTreeView::item, QListView::item, QTableView::item {
    padding: 3px 2px;
    border: none;
}
QTreeView::item:hover, QListView::item:hover, QTableView::item:hover { background: {{bg-2}}; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: {{accent-tint}};
    color: {{text}};
}

QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:closed { image: url({{DIR}}/ui/chevron-right.svg); }
QTreeView::branch:has-children:open   { image: url({{DIR}}/ui/chevron-down.svg); }

/* Options-dialog page list & sidebar */
QListWidget::item { padding: 7px 8px; border-radius: 6px; margin: 1px 4px; }

QHeaderView { background: {{bg-1}}; border: none; }
QHeaderView::section {
    background: {{bg-1}};
    color: {{text-muted}};
    border: none;
    border-bottom: 1px solid {{line}};
    border-right: 1px solid {{line}};
    padding: 6px 8px;
    font-weight: 600;
}
QHeaderView::section:hover { background: {{bg-2}}; color: {{text}}; }
QHeaderView::section:last { border-right: none; }
QHeaderView::up-arrow   { image: url({{DIR}}/ui/sort-up.svg);   width: 10px; height: 10px; subcontrol-position: center right; padding-right: 4px; }
QHeaderView::down-arrow { image: url({{DIR}}/ui/sort-down.svg); width: 10px; height: 10px; subcontrol-position: center right; padding-right: 4px; }
QTableCornerButton::section { background: {{bg-1}}; border: none; }

/* ---------- Progress ---------- */

QProgressBar {
    background: {{bg-3}};
    border: none;
    border-radius: 4px;
    color: {{text}};
    text-align: center;
    font-weight: 600;
}
QProgressBar::chunk { background: {{accent-fill}}; border-radius: 4px; }

/* ---------- Tabs (Transfers / Search / RSS / Log, dialogs) ---------- */

QTabWidget::pane { border: 1px solid {{line}}; border-radius: 8px; top: -1px; background: {{bg-1}}; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent;
    color: {{text-muted}};
    padding: 7px 14px;
    margin-right: 2px;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover    { color: {{text}}; }
QTabBar::tab:selected { color: {{text}}; border-bottom: 2px solid {{accent}}; }
QTabBar::close-button { image: url({{DIR}}/ui/x.svg); subcontrol-position: right; }
QTabBar::close-button:hover { background: {{bg-3}}; border-radius: 4px; }

/* ---------- Group boxes (Options dialog) ---------- */

QGroupBox {
    border: 1px solid {{line}};
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px 10px 8px 10px;
    background: {{bg-1}};
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: {{text-muted}};
    background: {{bg-0}};
}

/* Transparent backgrounds inside cards, so labels don't punch dark holes */
QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QRadioButton,
QScrollArea QLabel, QStackedWidget QLabel { background: transparent; }
QScrollArea, QScrollArea > QWidget > QWidget, QStackedWidget { background: {{bg-0}}; border: none; }

/* ---------- Scroll bars ---------- */

QScrollBar:vertical   { background: transparent; width: 10px;  margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle {
    background: {{bg-3}};
    border-radius: 3px;
    min-height: 32px;
    min-width: 32px;
}
QScrollBar::handle:hover   { background: {{line-strong}}; }
QScrollBar::handle:pressed { background: {{text-subtle}}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- Splitters, status bar, tooltips ---------- */

QSplitter::handle { background: {{bg-0}}; }
QSplitter::handle:hover { background: {{line}}; }
QSplitter::handle:horizontal { width: 5px; }
QSplitter::handle:vertical   { height: 5px; }

QStatusBar {
    background: {{bg-0}};
    color: {{text-muted}};
    border-top: 1px solid {{line}};
}
QStatusBar::item { border: none; }
QStatusBar QLabel, QStatusBar QPushButton { background: transparent; color: {{text-muted}}; }
QStatusBar QPushButton { border: 1px solid transparent; padding: 3px 8px; }
QStatusBar QPushButton:hover { background: {{bg-2}}; border-color: {{line}}; color: {{text}}; }

QToolTip {
    background: {{bg-2}};
    color: {{text}};
    border: 1px solid {{line-strong}};
    border-radius: 6px;
    padding: 5px 8px;
}

QLabel { background: transparent; }
QLabel[openExternalLinks="true"], QLabel:link { color: {{seed}}; }

QSlider::groove:horizontal { height: 4px; background: {{bg-3}}; border-radius: 2px; }
QSlider::sub-page:horizontal { background: {{accent-fill}}; border-radius: 2px; }
QSlider::handle:horizontal {
    background: {{text}}; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px;
}

QDialogButtonBox { button-layout: 0; }
